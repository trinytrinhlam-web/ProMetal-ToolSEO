# =====================================================================
# File mẫu cấu hình SEO App.
# Cách dùng: sao chép file này thành ".env" (cùng thư mục) rồi điền giá trị.
# File .env chứa bí mật: KHÔNG gửi cho ai, KHÔNG đưa lên GitHub
# (.gitignore đã chặn sẵn).
#
# Lưu ý khi viết đường dẫn thư mục/tệp trên Windows: dùng dấu "/" thay cho
# dấu "\" và không đặt trong ngoặc kép. Ví dụ: C:/Users/Lam/anh-san-pham
# =====================================================================

# --- Đăng nhập app ---------------------------------------------------
# Mã băm của mật khẩu đăng nhập (không phải mật khẩu thật).
# Đừng tự gõ: bấm đúp set_password.bat (Windows) / set_password.command (Mac)
# để tạo, script sẽ tự ghi vào đây.
APP_PASSWORD_HASH=

# Múi giờ dùng cho lịch đăng bài. Để trống = Asia/Ho_Chi_Minh.
APP_TIMEZONE=Asia/Ho_Chi_Minh

# --- WordPress (dùng từ Giai đoạn 1) ---------------------------------
# Địa chỉ website, ví dụ: https://example.com
WORDPRESS_URL=
# Tên đăng nhập WordPress của tài khoản sẽ đăng bài.
WORDPRESS_USERNAME=
# Application Password tạo trong WordPress: Người dùng > Hồ sơ > Application Passwords.
# Không phải mật khẩu đăng nhập WordPress thường.
WORDPRESS_APP_PASSWORD=

# --- AI (dùng từ Giai đoạn 2; chỉ cần khóa của nhà cung cấp bạn dùng) ---
# Khóa API Anthropic (Claude): https://console.anthropic.com
ANTHROPIC_API_KEY=
# Khóa API OpenAI: https://platform.openai.com/api-keys
OPENAI_API_KEY=
# Khóa API Google Gemini: https://aistudio.google.com/apikey
GEMINI_API_KEY=

# --- Google (dùng từ Giai đoạn 5 và 6) -------------------------------
# Đường dẫn đầy đủ tới file khóa JSON của tài khoản dịch vụ Google (service account).
# Giữ file này như mật khẩu: không gửi qua email, Zalo; máy thứ hai thì chép bằng USB.
# Để file NGOÀI thư mục phần mềm và NGOÀI thư mục ảnh: app từ chối file nằm trong đó.
# Không để trong thư mục đồng bộ lên mây (Google Drive, OneDrive, Dropbox, iCloud).
# Google đặt tên file kiểu "ten-project-1a2b3c4d5e6f.json"; .gitignore KHÔNG chặn tên này.
# Mac: chỉ mình bạn đọc được file (Terminal: chmod 600 <đường dẫn file>).
# Biến này chỉ sửa tay ở đây, app không ghi.
# Ví dụ Windows: C:/Users/ten-ban/bi-mat/khoa-google.json
# Ví dụ Mac:     /Users/ten-ban/bi-mat/khoa-google.json
GOOGLE_SERVICE_ACCOUNT_FILE=
# Mã Google Sheet kế hoạch từ khóa: đoạn giữa /d/ và /edit trong link Sheet
# (25–100 ký tự: chữ không dấu, số, "-" và "_"). Nên dán link Sheet ở trang Cài đặt để
# app tự lấy mã. Giữ kín mã này; Sheet chỉ chia sẻ cho email của tài khoản dịch vụ,
# đừng bật "Bất kỳ ai có đường liên kết".
GOOGLE_SHEET_ID=
# Website trong Search Console, ví dụ: https://example.com/ hoặc sc-domain:example.com
GSC_SITE_URL=

# --- Ảnh thật (dùng từ Giai đoạn 3) ----------------------------------
# Các thư mục chứa ảnh (USB, Google Drive for Desktop...), ngăn cách bằng dấu ";".
# Ví dụ Windows: E:/anh-cong-trinh;G:/My Drive/Anh SEO
# Ví dụ Mac:     /Volumes/USB/anh-cong-trinh;/Users/lam/Google Drive/Anh SEO
IMAGE_FOLDERS=
